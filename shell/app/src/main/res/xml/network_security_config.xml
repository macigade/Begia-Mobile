<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView loads the recorder over plain HTTP, but only on this phone's
     own loopback; nothing else may go in the clear. The laptop's BEGIA (the
     second-screen mode) is HTTPS with its own CA and is handled separately. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
