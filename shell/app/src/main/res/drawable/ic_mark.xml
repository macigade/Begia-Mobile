<?xml version="1.0" encoding="utf-8"?>
<!-- The boot screen's mark: ui/brand/begia-wave-through.svg in the desktop
     repo, the same drawing the launcher icon is (ic_launcher_foreground.xml) -
     the stepped trace at full strength outside the lens and at 40% seen
     through it, the lens ring, the amber iris - at its own size and crop
     (viewBox 504 26 174 116). The SVG's two clips are clip-paths here: the
     inside is the almond; the outside is the box with the almond run the
     other way, which the non-zero rule of a clip-path leaves out. The iris
     gradients are the SVG's bounding-box ones in user units. The screen is
     always dark, so this is the dark drawing. Written by a script from the
     SVG's numbers; change the SVG, then this. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="174dp"
    android:height="116dp"
    android:viewportWidth="174"
    android:viewportHeight="116">
    <group android:translateX="-504" android:translateY="-26">
        <!-- the glow behind everything -->
        <path android:pathData="M 591 84 m -42 0 a 42 42 0 1 0 84 0 a 42 42 0 1 0 -84 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="591" android:centerY="84" android:gradientRadius="42">
                    <item android:offset="0" android:color="#387FC3E8" />
                    <item android:offset="0.45" android:color="#1C5BA8DA" />
                    <item android:offset="1" android:color="#005BA8DA" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- the trace outside the lens -->
        <group>
            <clip-path android:pathData="M 504 26 H 678 V 142 H 504 Z M 544 84 A 58.02 58.02 0 0 0 638 84 A 58.02 58.02 0 0 0 544 84 Z" />
            <path
                android:pathData="M 508 84 H 512 V 80 H 520 V 88 H 528 V 81 H 536 V 84 H 552 V 70 H 562 V 96 H 572 V 74 H 584 V 64 H 598 V 94 H 610 V 72 H 620 V 84 H 646 V 81 H 654 V 88 H 662 V 80 H 670 V 84 H 674"
                android:fillColor="#00000000"
                android:strokeWidth="3.6"
                android:strokeLineCap="round"
                android:strokeLineJoin="miter">
                <aapt:attr name="android:strokeColor">
                    <gradient android:type="linear" android:startX="508" android:startY="84" android:endX="674" android:endY="84">
                        <item android:offset="0" android:color="#8C7E97AA" />
                        <item android:offset="0.14" android:color="#FF93B4C9" />
                        <item android:offset="0.217" android:color="#FFBFE4F8" />
                        <item android:offset="0.5" android:color="#FFF6FCFF" />
                        <item android:offset="0.783" android:color="#FFBFE4F8" />
                        <item android:offset="0.86" android:color="#FF93B4C9" />
                        <item android:offset="1" android:color="#8C7E97AA" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
        <!-- the lens ring, lit from the top -->
        <path
            android:fillType="evenOdd"
            android:pathData="M 536 84 A 63.27 63.27 0 0 1 646 84 A 63.27 63.27 0 0 1 536 84 Z M 544 84 A 58.02 58.02 0 0 0 638 84 A 58.02 58.02 0 0 0 544 84 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="591" android:startY="52" android:endX="591" android:endY="116">
                    <item android:offset="0" android:color="#FFF6FAFD" />
                    <item android:offset="0.18" android:color="#FFDCE7F2" />
                    <item android:offset="0.42" android:color="#FFAFC3D8" />
                    <item android:offset="0.62" android:color="#FF8AA3BD" />
                    <item android:offset="0.86" android:color="#FF74909F" />
                    <item android:offset="1" android:color="#FFB6C9DB" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- the trace seen through the lens, at 40% -->
        <group>
            <clip-path android:pathData="M 544 84 A 58.02 58.02 0 0 0 638 84 A 58.02 58.02 0 0 0 544 84 Z" />
            <path
                android:pathData="M 508 84 H 512 V 80 H 520 V 88 H 528 V 81 H 536 V 84 H 552 V 70 H 562 V 96 H 572 V 74 H 584 V 64 H 598 V 94 H 610 V 72 H 620 V 84 H 646 V 81 H 654 V 88 H 662 V 80 H 670 V 84 H 674"
                android:fillColor="#00000000"
                android:strokeWidth="3.6"
                android:strokeAlpha="0.4"
                android:strokeLineCap="round"
                android:strokeLineJoin="miter">
                <aapt:attr name="android:strokeColor">
                    <gradient android:type="linear" android:startX="508" android:startY="84" android:endX="674" android:endY="84">
                        <item android:offset="0" android:color="#8C7E97AA" />
                        <item android:offset="0.14" android:color="#FF93B4C9" />
                        <item android:offset="0.217" android:color="#FFBFE4F8" />
                        <item android:offset="0.5" android:color="#FFF6FCFF" />
                        <item android:offset="0.783" android:color="#FFBFE4F8" />
                        <item android:offset="0.86" android:color="#FF93B4C9" />
                        <item android:offset="1" android:color="#8C7E97AA" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
        <!-- the amber haze, the iris, the shadow that rounds it -->
        <path android:pathData="M 591 84 m -24 0 a 24 24 0 1 0 48 0 a 24 24 0 1 0 -48 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="591" android:centerY="84" android:gradientRadius="24">
                    <item android:offset="0.55" android:color="#61F5B731" />
                    <item android:offset="0.82" android:color="#21E09A22" />
                    <item android:offset="1" android:color="#00D6851A" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M 591 84 m -13 0 a 13 13 0 1 0 26 0 a 13 13 0 1 0 -26 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="588.92" android:centerY="80.88" android:gradientRadius="20.28">
                    <item android:offset="0" android:color="#FFFFF9DE" />
                    <item android:offset="0.16" android:color="#FFFFEFAE" />
                    <item android:offset="0.5" android:color="#FFF5B731" />
                    <item android:offset="0.84" android:color="#FFDE9020" />
