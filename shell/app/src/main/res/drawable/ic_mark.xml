                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M 591 84 m -13 0 a 13 13 0 1 0 26 0 a 13 13 0 1 0 -26 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="594.64" android:centerY="90.24" android:gradientRadius="15.6">
                    <item android:offset="0.5" android:color="#007A3F06" />
                    <item android:offset="1" android:color="#577A3F06" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
