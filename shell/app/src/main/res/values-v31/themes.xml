<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later draw their own launch splash - the app icon on a
     plate - before any of the app runs, which read as a second loading
     screen ahead of the welcome animation. With no icon and the app's own
     background it is a blank instant that the boot page paints over. -->
<resources>
    <style name="Theme.BEGIA" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="alertDialogTheme">@style/Theme.BEGIA.Dialog</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/bg</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
