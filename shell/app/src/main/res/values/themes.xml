<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BEGIA" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="alertDialogTheme">@style/Theme.BEGIA.Dialog</item>
    </style>
    <style name="Theme.BEGIA.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/panel</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColor">@color/ink</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
