<?xml version="1.0" encoding="utf-8"?>
<!-- The BEGIA mark with the waveform through the eye: ui/brand/
     begia-wave-through.svg in the desktop repo, the same geometry - the
     stepped trace at full strength outside the lens and at 40% seen
     through it, the lens ring, the amber iris - scaled 0.52 and centred so
     the trace's tails (with their round caps) end 33dp from the centre:
     inside the launcher's 72dp keep-zone and inside the tighter circle Wear
     crops to, which cut them at 0.58. Android has no clip here, so "outside" is the trace drawn
     in full, the inside of the eye painted over in the icon's background,
     and the trace drawn once more at 40% (the same colour over itself
     changes nothing outside, and is the 40% inside).

     Hand-written from the SVG on purpose - the generator in the desktop
     repo (tools/make_android_icon.py) draws the kit's iris-and-orbits mark,
     which is not this one. The wear module's copy is identical. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.52"
        android:scaleY="0.52"
        android:translateX="-253.32"
        android:translateY="10.32">
        <!-- the glow behind everything -->
        <path android:pathData="M 591 84 m -42 0 a 42 42 0 1 0 84 0 a 42 42 0 1 0 -84 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="591" android:centerY="84" android:gradientRadius="42">
                    <item android:offset="0" android:color="#387FC3E8" />
                    <item android:offset="0.45" android:color="#1C5BA8DA" />
                    <item android:offset="1" android:color="#005BA8DA" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- the trace, in full; the tails end where the mask would cut them -->
        <path
            android:pathData="M 530 81 H 536 V 84 H 552 V 70 H 562 V 96 H 572 V 74 H 584 V 64 H 598 V 94 H 610 V 72 H 620 V 84 H 646 V 81 H 652"
            android:fillColor="#00000000"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="miter">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="530" android:startY="84" android:endX="652" android:endY="84">
                    <item android:offset="0" android:color="#FF93B4C9" />
                    <item android:offset="0.16" android:color="#FFBFE4F8" />
                    <item android:offset="0.5" android:color="#FFF6FCFF" />
                    <item android:offset="0.84" android:color="#FFBFE4F8" />
                    <item android:offset="1" android:color="#FF93B4C9" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- the inside of the eye, then the trace again at 40%: seen through the lens -->
        <path
            android:pathData="M 544 84 A 58.02 58.02 0 0 0 638 84 A 58.02 58.02 0 0 0 544 84 Z"
            android:fillColor="@color/bg" />
        <path
            android:pathData="M 530 81 H 536 V 84 H 552 V 70 H 562 V 96 H 572 V 74 H 584 V 64 H 598 V 94 H 610 V 72 H 620 V 84 H 646 V 81 H 652"
            android:fillColor="#00000000"
            android:strokeWidth="3.6"
            android:strokeAlpha="0.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="miter">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="530" android:startY="84" android:endX="652" android:endY="84">
                    <item android:offset="0" android:color="#FF93B4C9" />
                    <item android:offset="0.16" android:color="#FFBFE4F8" />
                    <item android:offset="0.5" android:color="#FFF6FCFF" />
                    <item android:offset="0.84" android:color="#FFBFE4F8" />
                    <item android:offset="1" android:color="#FF93B4C9" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- the lens ring, lit from the top -->
        <path
            android:fillType="evenOdd"
            android:pathData="M 536 84 A 63.27 63.27 0 0 1 646 84 A 63.27 63.27 0 0 1 536 84 Z M 544 84 A 58.02 58.02 0 0 0 638 84 A 58.02 58.02 0 0 0 544 84 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="591" android:startY="52" android:endX="591" android:endY="116">
                    <item android:offset="0" android:color="#FFF6FAFD" />
                    <item android:offset="0.18" android:color="#FFDCE7F2" />
                    <item android:offset="0.42" android:color="#FFAFC3D8" />
                    <item android:offset="0.62" android:color="#FF8AA3BD" />
                    <item android:offset="0.86" android:color="#FF74909F" />
                    <item android:offset="1" android:color="#FFB6C9DB" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- the amber haze, the iris, the shadow that rounds it -->
        <path android:pathData="M 591 84 m -24 0 a 24 24 0 1 0 48 0 a 24 24 0 1 0 -48 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="591" android:centerY="84" android:gradientRadius="24">
                    <item android:offset="0.55" android:color="#61F5B731" />
                    <item android:offset="0.82" android:color="#21E09A22" />
                    <item android:offset="1" android:color="#00D6851A" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M 591 84 m -13 0 a 13 13 0 1 0 26 0 a 13 13 0 1 0 -26 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="588.9" android:centerY="80.9" android:gradientRadius="20.3">
                    <item android:offset="0" android:color="#FFFFF9DE" />
                    <item android:offset="0.16" android:color="#FFFFEFAE" />
                    <item android:offset="0.5" android:color="#FFF5B731" />
                    <item android:offset="0.84" android:color="#FFDE9020" />
                    <item android:offset="1" android:color="#FFD6851A" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M 591 84 m -13 0 a 13 13 0 1 0 26 0 a 13 13 0 1 0 -26 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="594.6" android:centerY="90.2" android:gradientRadius="15.6">
                    <item android:offset="0.5" android:color="#007A3F06" />
                    <item android:offset="1" android:color="#577A3F06" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
